DATABASE_URL=postgresql://user:password@host/schedo
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000
# Both NEXT_PUBLIC_MAPBOX_TOKEN (browser) and MAPBOX_TOKEN (server-side geocoding) use the same Mapbox token value
NEXT_PUBLIC_MAPBOX_TOKEN=pk.eyJ1...
MAPBOX_TOKEN=pk.eyJ1...
# Gmail SMTP for transactional email (nodemailer). GMAIL_APP_PASSWORD must be a
# 16-char Google App Password (requires 2-Step Verification), NOT the account password.
GMAIL_USER=your-account@gmail.com
GMAIL_APP_PASSWORD=abcdefghijklmnop
# Base64-encoded 32-byte key for encrypting guest PII at rest (AES-256-GCM).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating this key loses access to data encrypted under the old key unless that data is re-encrypted.
ENCRYPTION_KEY=

DATABASE_URL=postgresql://user:password@host/schedo
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000
# Both NEXT_PUBLIC_MAPBOX_TOKEN (browser) and MAPBOX_TOKEN (server-side geocoding) use the same Mapbox token value
NEXT_PUBLIC_MAPBOX_TOKEN=pk.eyJ1...
MAPBOX_TOKEN=pk.eyJ1...
RESEND_API_KEY=re_...
RESEND_FROM=Schedo <noreply@schedo.app>

DATABASE_URL=postgresql://user:password@host/schedo
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000
# Both NEXT_PUBLIC_MAPBOX_TOKEN (browser) and MAPBOX_TOKEN (server-side geocoding) use the same Mapbox token value
NEXT_PUBLIC_MAPBOX_TOKEN=pk.eyJ1...
MAPBOX_TOKEN=pk.eyJ1...
# Transactional email via Resend (resend.com). Verify your sending domain
# (e.g. schedo.me) in Resend and add the DNS records it gives you. When unset,
# email sending is a silent no-op.
RESEND_API_KEY=re_xxxxxxxx
# Visible sender (must be on the verified domain) and reply-to.
MAIL_FROM=Schedo <contact@schedo.me>
MAIL_REPLY_TO=contact@schedo.me
# Base64-encoded 32-byte key for encrypting guest PII at rest (AES-256-GCM).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating this key loses access to data encrypted under the old key unless that data is re-encrypted.
ENCRYPTION_KEY=
# Google OAuth for provider sign-in + Calendar sync. Leave unset to disable.
# Authorized redirect URI in Google Cloud: <NEXTAUTH_URL>/api/auth/callback/google
# Enable the Google Calendar API on the project. Calendar read scope is requested at sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Set to "true" to show the "Continue with Google" buttons (client-visible).
NEXT_PUBLIC_GOOGLE_ENABLED=
# Upstash Redis for per-IP rate limiting on public booking/search endpoints.
# Create a free Upstash Redis DB at https://upstash.com and paste the REST URL + token.
# When BOTH are unset, rate limiting is a silent no-op (dormant) — safe to leave blank.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Vercel Blob storage for provider avatar uploads. Create a Blob store in the
# Vercel dashboard (Storage → Blob); it provisions this token automatically.
# When unset, avatar upload returns a 503 (the rest of the app is unaffected).
BLOB_READ_WRITE_TOKEN=
